{
  "name": "byheart",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/build-sw.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.worker.json",
    "test": "vitest run --coverage",
    "e2e": "playwright test",
    "serve": "WRANGLER_SEND_METRICS=false wrangler dev --local --infer-origin-from-routes=false --port 8793",
    "content:build": "python3 scripts/build-content.py",
    "content:verify": "node scripts/verify-content.mjs"
  },
  "dependencies": {
    "@fontsource/figtree": "5.2.8",
    "@fontsource/literata": "5.2.8",
    "@simplewebauthn/browser": "13.2.2",
    "@simplewebauthn/server": "13.3.3",
    "svelte": "5.57.3",
    "ts-fsrs": "5.2.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261113.1",
    "@playwright/test": "1.56.1",
    "@sveltejs/vite-plugin-svelte": "6.2.1",
    "@tsconfig/svelte": "5.0.5",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "5.1.0",
    "svelte-check": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "5.1.0",
    "wrangler": "4.161.0"
  }
}
