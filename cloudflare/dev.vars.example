# Copy to ../.dev.vars locally; never commit actual credentials.
SESSION_SECRET="replace-with-at-least-32-random-characters"
STATS_TOKEN="replace-with-a-separate-random-stats-access-token"
# ESV_API_KEY="your-crossway-api-key"
# APP_ORIGIN="http://localhost:8793"
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# VAPID_PUBLIC_KEY="base64url-uncompressed-public-P256-key"
# VAPID_PRIVATE_KEY="base64url-private-P256-scalar"
# VAPID_SUBJECT="mailto:operator@example.com"

# Email sign-in uses ACCOUNTS_SVC (wrangler service binding, IncordClient).
# ACCOUNTS_GOOGLE=0 # Leave legacy Google default until prod verification.
# Resend below is for feedback notifications, not sign-in codes.
# Replies go to incord@jesklabs.com.
# RESEND_API_KEY=""
# EMAIL_FROM="Incord <signin@incord.jesklabs.com>"
# EMAIL_TEST_SINK="1" # LOCAL ONLY: localhost/127.0.0.1 are also required.
